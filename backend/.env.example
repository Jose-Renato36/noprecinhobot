# ------------------------------------------------------------------
# NoPrecinhoBot — copie este arquivo para .env e ajuste o que precisar.
# Tudo tem valor padrão: sem .env o projeto roda com SQLite local.
# ------------------------------------------------------------------

# Banco de dados
# Local (padrão): SQLite em backend/noprecinho.db
# Railway: a variável já vem preenchida com o PostgreSQL do projeto
# DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# Agendador
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=360   # 6 horas (use 1 ou 2 para demonstrar ao vivo)
COLETA_AO_INICIAR=false

# Scraper
SCRAPER_TIMEOUT=20
SCRAPER_DELAY_SEGUNDOS=1.0
SCRAPER_TENTATIVAS=3
VARIACAO_MAXIMA_FATOR=4.0   # acima disso a coleta é descartada como erro de extração

# Fallback de navegador headless, para lojas que montam o preço por JavaScript.
#   auto  (padrão) usa se o Playwright estiver instalado, ignora se não estiver
#   true            exige o Playwright
#   false           nunca usa
# Requer `playwright install chromium` uma vez.
# NÃO resolve antibot (Shopee, Magalu e Mercado Livre continuam bloqueando).
NAVEGADOR_FALLBACK=auto
NAVEGADOR_ESPERA_PRECO_MS=8000

# Notificação por e-mail (Resend) — opcional
# EMAIL_ENABLED=false desliga o envio por completo, mesmo havendo chave. O alerta
# continua sendo gravado e aparecendo no painel — o e-mail é só um canal a mais.
EMAIL_ENABLED=false
# Sem a chave, o alerta é registrado no banco e aparece no painel, só não sai e-mail.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=NoPrecinhoBot <onboarding@resend.dev>
# EMAIL_DESTINO=seu-email@exemplo.com

# Autenticação
# SECRET_KEY assina os tokens. Sem ela, uma chave aleatória é gerada a cada boot
# — o que derruba todas as sessões a cada reinício. Defina em produção.
# Para gerar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRA_MINUTOS=720   # 12 horas

# A sessão viaja num cookie httpOnly — invisível ao JavaScript, ao contrário de
# localStorage/sessionStorage, que um XSS lê à vontade.
# COOKIE_NOME=noprecinho_sessao
# false (padrão) = cookie de sessão: o navegador o descarta ao fechar.
# true            = persiste por JWT_EXPIRA_MINUTOS.
COOKIE_PERSISTENTE=false
# Secure exige HTTPS. Segue o esquema da BASE_URL sozinho; só defina para forçar.
# COOKIE_SEGURO=true
# COOKIE_SAMESITE=strict
# Com false, /api/auth/registrar recusa novas contas; as existentes continuam entrando.
REGISTRO_ABERTO=true

# Proteção contra abuso
RATE_LIMIT_ENABLED=true
# Quantos proxies confiáveis há na frente da API. Na Railway (proxy na borda) é 1.
# Use 0 se a API estiver exposta direto: confiar no X-Forwarded-For sem proxy
# deixa qualquer um forjar o IP e escapar do limite.
CONFIAR_PROXIES=1

LIMITE_LOGIN=10             # tentativas de login por IP...
LIMITE_LOGIN_JANELA=300     # ...a cada 5 minutos
LIMITE_REGISTRO=5           # contas criadas por IP...
LIMITE_REGISTRO_JANELA=3600 # ...por hora
LIMITE_SCRAPING=20          # chamadas que disparam o scraper por IP...
LIMITE_SCRAPING_JANELA=60   # ...por minuto

# Trava por conta: pega o ataque distribuído, em que cada tentativa vem de um IP
# diferente e o limite por IP nunca dispara. O bloqueio dobra a cada rodada.
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_SEGUNDOS=60
LOGIN_BLOQUEIO_TETO_SEGUNDOS=900

# Quem informa a URL é o usuário, mas quem faz a requisição é o servidor — então
# sem trava o sistema vira ponte para a rede privada da hospedagem (SSRF).
# Endereços internos são recusados; a loja-demo é liberada por ser a própria
# BASE_URL. Ligue só para desenvolver contra uma loja local em outro endereço.
PERMITIR_REDE_INTERNA=false

# Libera a origem localhost no CORS. Segue a BASE_URL sozinho (ligado em http,
# desligado em https); só defina para forçar.
# CORS_PERMITIR_LOCALHOST=true

# API
BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_STORE_ENABLED=true
