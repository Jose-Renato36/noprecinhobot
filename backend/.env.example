# ------------------------------------------------------------------
# NoPrecinhoBot — copie este arquivo para .env e ajuste o que precisar.
# Tudo tem valor padrão: sem .env o projeto roda com SQLite local.
# ------------------------------------------------------------------

# Banco de dados
# Local (padrão): SQLite em backend/noprecinho.db
# Railway: a variável já vem preenchida com o PostgreSQL do projeto
# DATABASE_URL=postgresql://usuario:senha@host:5432/railway

# Agendador
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=360   # 6 horas (use 1 ou 2 para demonstrar ao vivo)
COLETA_AO_INICIAR=false

# Scraper
SCRAPER_TIMEOUT=20
SCRAPER_DELAY_SEGUNDOS=1.0
SCRAPER_TENTATIVAS=3
VARIACAO_MAXIMA_FATOR=4.0   # acima disso a coleta é descartada como erro de extração

# Fallback de navegador headless, para lojas que montam o preço por JavaScript.
#   auto  (padrão) usa se o Playwright estiver instalado, ignora se não estiver
#   true            exige o Playwright
#   false           nunca usa
# Requer `playwright install chromium` uma vez.
# NÃO resolve antibot (Shopee, Magalu e Mercado Livre continuam bloqueando).
NAVEGADOR_FALLBACK=auto
NAVEGADOR_ESPERA_PRECO_MS=8000

# Notificação por e-mail (Resend) — opcional
# Sem a chave, o alerta é registrado no banco e aparece no painel, só não sai e-mail.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=NoPrecinhoBot <onboarding@resend.dev>
# EMAIL_DESTINO=seu-email@exemplo.com

# API
BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_STORE_ENABLED=true
